PORT=3002

# Environment
NODE_ENV=development

# Database configuration
DATABASE_URL=postgresql://postgres:123123@localhost:5432/ai_exam?schema=public

# JWT secret key
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3002/api/v1/auth/oauth/google/callback

# Frontend URL
FRONTEND_URL=https://frontend-sfal.vercel.app

# Base URL of this backend - used to build email verification and password reset links
BACKEND_URL=http://localhost:3002

# SMTP (Gmail) configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=

# AI Assistant Settings
DEFAULT_REQUESTED_QUESTIONS=10
MAX_REQUESTED_QUESTIONS=20
MIN_REFERENCE_QUESTIONS=3
MAX_REFERENCE_QUESTIONS=10
OLLAMA_TIMEOUT_MS=120000

# Upload
MAX_FILE_SIZE=20971520
UPLOAD_DIR=./uploads

# Redis — اختياري. مطلوب فقط لمهام الخلفية (استخراج الامتحانات،
# التضمين، تحليل النمط). بدونه التطبيق بيشتغل عادي وهالمهام بتتعطّل.
# REDIS_URL="redis://localhost:6379"

# مفتاح تشفير البيانات الحساسة (أسرار 2FA) وتوقيع روابط الملفات المحلية.
# ولّده بـ:  openssl rand -hex 32
# مطلوب بالإنتاج. بالتطوير إذا تركته فاضي بينستعمل JWT_SECRET بدله.
ENCRYPTION_KEY=""

# RabbitMQ connection string
RABBITMQ_URL="amqp://localhost:5672"

# التخزين — افتراضياً على قرص السيرفر تحت UPLOAD_DIR، بدون أي سيرفر تخزين.
# عبّي الأربعة التحت مشان تستعمل S3 أو MinIO أو Backblaze B2 أو R2 بدلها.
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET_NAME=""
# AWS_S3_ENDPOINT=""

# AI — Claude is the primary provider when ANTHROPIC_API_KEY is set: it reads
# textbook/exam PDFs natively (Arabic, math, tables) 10–20 pages per request, and
# also answers chat and generates questions. Get a key at
# https://platform.claude.com/settings/keys. Model defaults to claude-opus-5.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5"
# Only for organization-level keys (error "API key is not scoped to a workspace"):
# the workspace ID from Console → Settings → Workspaces. Workspace keys need nothing.
# ANTHROPIC_WORKSPACE_ID=""

# OpenRouter — used when ANTHROPIC_API_KEY is empty, and as the fallback when
# Claude is overloaded. Free models are capped at ~50 requests/day without
# credits, which is not enough to OCR a textbook.
OPENROUTER_API_KEY=""
OPENROUTER_PARSER_MODEL="google/gemini-2.5-flash"
OPENROUTER_GENERATION_MODEL="google/gemini-2.5-flash"
# Tried in order when the models above are rate-limited or down (comma-separated)
OPENROUTER_FALLBACK_MODELS=""

# Embeddings (RAG). EMBEDDING_PROVIDER = local | gemini | openrouter.
# Empty = gemini if GEMINI_API_KEY is set, otherwise local.
# local: free, open-source multilingual-e5 (supports Arabic) running on this
# server via Transformers.js — downloads ~130 MB once into apps/api/.cache/models.
# Changing provider/model means re-embedding: Library → «إعادة التضمين» for
# books, bulk re-embed for the bank.
EMBEDDING_PROVIDER=""
# LOCAL_EMBEDDING_MODEL="Xenova/multilingual-e5-small"
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
OPENROUTER_EMBEDDING_MODEL="google/gemini-embedding-001"
# gemini/openrouter only — local models have a fixed size (e5-small: 384)
EMBEDDING_DIMENSIONS=768

# Sprint 3 — AI Question Generation
DAILY_GENERATION_QUOTA=20
STYLE_UPLOAD_MAX_SIZE=15728640
