PORT=3002

# Environment
NODE_ENV=development

# Database configuration
DATABASE_URL=postgresql://postgres:123123@localhost:5432/ai_exam?schema=public

# JWT secret key
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3002/api/v1/auth/oauth/google/callback

# Frontend URL
FRONTEND_URL=https://frontend-sfal.vercel.app

# Base URL of this backend - used to build email verification and password reset links
BACKEND_URL=http://localhost:3002

# SMTP (Gmail) configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
MAIL_FROM=

# AI Assistant Settings
DEFAULT_REQUESTED_QUESTIONS=10
MAX_REQUESTED_QUESTIONS=20
MIN_REFERENCE_QUESTIONS=3
MAX_REFERENCE_QUESTIONS=10
OLLAMA_TIMEOUT_MS=120000

# Upload
MAX_FILE_SIZE=20971520
UPLOAD_DIR=./uploads

# Redis — اختياري. مطلوب فقط لمهام الخلفية (استخراج الامتحانات،
# التضمين، تحليل النمط). بدونه التطبيق بيشتغل عادي وهالمهام بتتعطّل.
# REDIS_URL="redis://localhost:6379"

# مفتاح تشفير البيانات الحساسة (أسرار 2FA) وتوقيع روابط الملفات المحلية.
# ولّده بـ:  openssl rand -hex 32
# مطلوب بالإنتاج. بالتطوير إذا تركته فاضي بينستعمل JWT_SECRET بدله.
ENCRYPTION_KEY=""

# RabbitMQ connection string
RABBITMQ_URL="amqp://localhost:5672"

# التخزين — افتراضياً على قرص السيرفر تحت UPLOAD_DIR، بدون أي سيرفر تخزين.
# عبّي الأربعة التحت مشان تستعمل S3 أو MinIO أو Backblaze B2 أو R2 بدلها.
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET_NAME=""
# AWS_S3_ENDPOINT=""

# Google Gemini API Configuration 
GEMINI_API_KEY=""
GEMINI_PARSER_MODEL="gemini-3.5-flash"
GEMINI_GENERATION_MODEL="gemini-3.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS=768

# Sprint 3 — AI Question Generation
DAILY_GENERATION_QUOTA=20
STYLE_UPLOAD_MAX_SIZE=15728640
